# Copy to .env and fill in whichever keys you have. Any agent whose provider
# has no key automatically falls back to the deterministic mock LLM.

# Groq (groq.com - OpenAI-compatible fast inference; NOT xAI's "Grok" model,
# despite the similar name). Three keys, one dedicated per child agent
# (agent1/agent2/agent3); master_agent and scope_guard reuse keys 1/2 since
# they run sequentially, not concurrently. Each key is optional independently.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# xAI Grok (unused unless you add a key here - kept for future use).
GROK_API_KEY=
GROK_MODEL=grok-4
GROK_BASE_URL=https://api.x.ai/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
